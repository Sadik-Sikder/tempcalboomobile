<resources>

    <!-- Base application theme. Light only: the JS UI has no dark palette,
         so a DayNight parent made native pieces (Alert dialogs, pickers)
         turn dark over light screens when the phone is in dark mode. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Dark status bar icons from the first frame, not only once JS
             mounts App's <StatusBar barStyle="dark-content" />. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
